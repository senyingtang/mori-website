# ---------------------------------------------------------------------------
# 環境變數範例（不含真實金鑰；請勿將任何密鑰提交至 Git）
# ---------------------------------------------------------------------------
# 提醒：
# - 不要把 Supabase service_role key 放在 NEXT_PUBLIC_* 變數（會暴露給瀏覽器）。
# - 不要把資料庫密碼放進前端環境變數（NEXT_PUBLIC_* 皆會被打包進客戶端）。
# - 本機開發請複製 .env.local.example 為 .env.local 後再填入值。
# - .env.local 不可 commit 到 GitHub（已由 .gitignore 排除）。
# - Vercel 需另外在 Project Settings → Environment Variables 設定這些值。
# ---------------------------------------------------------------------------

# Supabase Project URL（Dashboard → Settings → API）
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon（公開）key（Dashboard → Settings → API；僅此種 key 可放 NEXT_PUBLIC_）
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 網站基底 URL（canonical、sitemap、OG 絕對路徑；本機預設如下）
NEXT_PUBLIC_SITE_URL=http://localhost:3000
